// ai-assistant: in-app chat models (SAD §5, ADR-0007, ADR-0008, ADR-0009). Visible content only, never raw tool answers.

enum ConversationMessageRole {
    USER
    ASSISTANT
}

enum DraftCardState {
    LIVE // the only card in its Conversation that Create may use
    REPLACED // a newer card from a later message took its place (AC-14b)
    OUTDATED // rebuilt at a Create press with different content; the updated card replaced it (AC-18)
    CREATED // a Draft invoice was created from it (AC-13, AC-14)
}

// ai-chat-v2: who or what sent a Freelancer message (spec §1, AC-34). NULL on ASSISTANT messages.
enum MessageOrigin {
    TYPED // typed into the message box
    PRESSED // an Offered choice was pressed; set by the server only from a valid choice (ADR-0003)
    DASHBOARD // the dashboard prompt box (ADR-0009)
}

// ai-chat-v2: where a Conversation was started (spec §1, §7). Set with the first message, never changed.
enum ConversationStartPoint {
    AI_SECTION // New chat or the AI chat entry; also every Conversation saved before ai-chat-v2
    INVOICE_LIST // the existing "Create with AI" on the invoice list
    DASHBOARD_PROMPT // the dashboard prompt box
    DASHBOARD_CREATE // the dashboard's "Create invoice with AI"
}

// ai-chat-v2 (ADR-0002): which draft slot an offer fills.
enum ChoiceOfferKind {
    CUSTOMER
    SENDER_PROFILE
    CURRENCY
    BANK_ACCOUNT
    PRODUCT
}

// ai-chat-v2 (ADR-0001): one offer's life.
enum ChoiceOfferState {
    OPEN // the latest reply's buttons; at most one per Conversation
    CHOSEN // a press claimed it (released back to OPEN on a non-counted failure, or CLOSED when a newer message exists)
    CLOSED // a newer message was saved (or a release found one); no choice
}

enum AssistantTopic {
    IN_SCOPE
    MIXED
    OFF_TOPIC
}

enum AssistantTurnOutcome {
    ANSWERED // a full reply
    CAPPED // the 8-step cap ended the turn with a partial answer (AC-11b), counted
    FAILED // a system-side failure, provider errors and rate limits included (AC-11), not counted
    ALLOWANCE_USED_UP // refused before any model call (AC-10), not counted
}

// One chat thread; deleted 90 days after its last message (AC-38) or on request (AC-37).
model Conversation {
    id            String   @id @default(cuid())
    userId        String
    title         String // the first message, trimmed to 80 characters
    lastMessageAt DateTime // moved by every saved turn; drives the list order and the 90-day purge
    startedFrom   ConversationStartPoint @default(AI_SECTION) // ai-chat-v2: set with the first message, never changed

    user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
    messages   ConversationMessage[]
    draftCards DraftCard[]
    turns      AssistantTurn[]
    offers     ChoiceOffer[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId, lastMessageAt(sort: Desc)])
    @@index([lastMessageAt])
}

// One visible message: the Freelancer's text, or the Assistant's final text with link and card parts (ADR-0008).
model ConversationMessage {
    id             String                  @id @default(cuid())
    conversationId String
    position       Int // 0, 1, 2, … within the Conversation, written under the Conversation row lock
    role           ConversationMessageRole
    parts          Json // UI-message parts: text, links as ids or page keys, Draft card references
    origin         MessageOrigin? // ai-chat-v2: set on USER messages by the server; NULL on ASSISTANT messages

    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    offer        ChoiceOffer? // the Offered choices this ASSISTANT reply carries, if any

    createdAt DateTime @default(now())

    @@unique([conversationId, position])
}

// A proposed draft stored server-side; only the Freelancer's Create press turns it into an invoice (ADR-0007).
model DraftCard {
    id             String         @id @default(cuid())
    userId         String
    conversationId String
    state          DraftCardState @default(LIVE)
    request        Json // the structured request from propose_draft, re-resolved at every Create press
    proposal       Json // the resolved content the Freelancer saw, every value with its source
    replacedById   String? // the newer card that took this one's place (REPLACED or OUTDATED)
    invoiceId      String? // the Draft invoice created from it (CREATED); NULL again if that invoice is deleted

    user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    replacedBy   DraftCard?   @relation("DraftCardReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
    replaces     DraftCard[]  @relation("DraftCardReplacement")
    invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([conversationId], map: "DraftCard_conversationId_live_key", where: { state: "LIVE" }) // one live card per Conversation (SAD §6 flow 6)
    @@index([conversationId])
    @@index([userId])
    @@index([replacedById])
    @@index([invoiceId])
}

// ai-chat-v2 (ADR-0001, ADR-0002, ADR-0003): one set of Offered choices, built in code from a resolver issue and tied to
// the reply that shows it. A press claims it OPEN -> CHOSEN; a non-counted failure releases it (OPEN, or CLOSED when a
// newer message exists); any newer message closes it. Deleted with its Conversation.
model ChoiceOffer {
    id             String           @id @default(cuid())
    userId         String
    conversationId String
    messageId      String           @unique // the ASSISTANT reply that shows the buttons; one offer per reply at most
    kind           ChoiceOfferKind
    lineIndex      Int? // the invoice line the choice fills (PRODUCT only); NULL for the other kinds
    request        Json // the stored DraftRequest the offer continues; the chosen record is pinned into it (ADR-0003)
    options        Json // 1..8 frozen options: { optionId (position), label, ref }; never model text (ADR-0002)
    state          ChoiceOfferState @default(OPEN)
    chosenOptionId Int? // set with CHOSEN, cleared on release; NULL while OPEN or CLOSED

    user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
    conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    message      ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([conversationId], map: "ChoiceOffer_conversationId_open_key", where: { state: "OPEN" }) // one open offer per Conversation (SAD §6 Flags)
    @@index([conversationId])
    @@index([userId])
}

// Daily message allowance: one row per Freelancer per local day (ADR-0009). Counts only.
model MessageAllowanceDay {
    userId         String
    day            DateTime // the Freelancer's local calendar day, stored as that day at 00:00 UTC
    used           Int      @default(0) // reserved slots; a system-side failure gives its slot back
    timeZone       String // the zone the day was opened with (spec §8 time-zone rule)
    firstMessageAt DateTime // the first reservation of the day (spec §8 time-zone rule)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([userId, day])
    @@index([day])
}

// Per-turn metadata for the spec §7 KPIs; never text (ADR-0004). Survives Conversation deletion.
model AssistantTurn {
    id             String               @id @default(cuid())
    userId         String
    conversationId String?
    topic          AssistantTopic? // the router verdict; NULL when the turn ended before the router
    outcome        AssistantTurnOutcome
    counted        Boolean // whether the turn used a slot of the Daily message allowance
    steps          Int                  @default(0)
    toolNames      String[] // tools called, in order; names only
    durationMs     Int
    inputTokens    Int?
    outputTokens   Int?
    costUsd        Decimal?             @db.Decimal(10, 6)

    user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

    createdAt DateTime @default(now())

    @@index([userId])
    @@index([conversationId])
    @@index([createdAt])
}
