// Auth models used by Auth.js / NextAuth Prisma adapter

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String    @unique
    emailVerified DateTime?
    image         String?

    timeZone                 String? // ADR-0006; NULL = UTC until saved
    overdueNoticeDismissedAt DateTime?

    accounts         Account[]
    sessions         Session[]
    emailHistory     EmailHistory[]
    senderProfiles   SenderProfile[]
    customers        Customer[]
    products         Product[]
    logoFetchWindows LogoFetchWindow[]
    limitEvents      LimitEvent[]
    personalKeys     PersonalKey[]

    conversations        Conversation[]
    draftCards           DraftCard[]
    messageAllowanceDays MessageAllowanceDay[]
    assistantTurns       AssistantTurn[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Account {
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String?
    access_token      String?
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String?
    session_state     String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([provider, providerAccountId])
}

model Session {
    sessionToken String   @unique
    userId       String
    expires      DateTime

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model VerificationToken {
    identifier String
    token      String
    expires    DateTime

    @@id([identifier, token])
}

model LogoFetchWindow {
    userId      String
    windowStart DateTime
    count       Int      @default(0)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([userId, windowStart])
}

enum LimitScope {
    SIGNIN_SOURCE
    SIGNIN_ADDRESS
    EXPORT
    MCP_KEY
    MCP_SOURCE
}

enum LimitOutcome {
    REQUESTED
    SENT
    REFUSED
    ALERTED
    STARTED
    FAILED
}

// One row per counted or refused limited event (ADR-0002); purged after 24 h (ADR-0007).
model LimitEvent {
    id      String       @id @default(cuid())
    scope   LimitScope
    key     String
    outcome LimitOutcome
    at      DateTime     @default(now())
    userId  String?

    user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([scope, key, at])
    @@index([at])
    @@index([userId])
}

model EmailHistory {
    id        String   @id @default(cuid())
    userId    String
    oldEmail  String
    newEmail  String
    changedAt DateTime @default(now())
    reason    String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([oldEmail])
}

model PersonalKey {
    id              String    @id @default(cuid())
    userId          String
    name            String
    activeNameKey   String? // lower-case name while active, NULL once revoked
    digest          String    @unique // sha256 hex of the full key (ADR-0004)
    lastFour        String
    lastUsedAt      DateTime?
    firstSuccessAt  DateTime?
    revokedAt       DateTime?
    canCreateDrafts Boolean   @default(false) // Draft permission, set only at creation (ADR-0011)

    user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
    usageWeeks      PersonalKeyUsageWeek[]
    draftDays       PersonalKeyDraftDay[]
    draftRepeats    McpDraftRepeat[]
    assistantDrafts Invoice[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, activeNameKey])
}

// Weekly per-key usage counts for the KPIs (spec section 7); counts only, never content.
model PersonalKeyUsageWeek {
    personalKeyId   String
    weekStart       DateTime // Monday 00:00 UTC
    attempts        Int      @default(0)
    successes       Int      @default(0)
    assistantErrors Int      @default(0)

    personalKey PersonalKey @relation(fields: [personalKeyId], references: [id], onDelete: Cascade)

    @@id([personalKeyId, weekStart])
}

// Per-key daily draft limit: one row per key per local day (ADR-0009). Counts only. (06)
model PersonalKeyDraftDay {
    personalKeyId String
    day           DateTime // the Freelancer's local calendar day, stored as that day at 00:00 UTC
    created       Int       @default(0) // Assistant drafts created through the key that day
    allowance     Int       @default(50) // 50, plus 50 per lift (AC-28)
    lastLiftedAt  DateTime?

    personalKey PersonalKey @relation(fields: [personalKeyId], references: [id], onDelete: Cascade)

    @@id([personalKeyId, day])
    @@index([day])
}

// MCP repeat marks (ADR-0012): honoured for 24 hours, purged daily after that. (07)
model McpDraftRepeat {
    personalKeyId String
    repeatKey     String
    fingerprint   String // sha256 hex of the canonical request; the same mark with other content is refused
    invoiceId     String? // the first draft; NULL once that invoice is deleted
    proposal      Json? // the first answer's DraftProposal (11); NULL on rows written before it

    personalKey PersonalKey @relation(fields: [personalKeyId], references: [id], onDelete: Cascade)
    invoice     Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

    createdAt DateTime @default(now())

    @@id([personalKeyId, repeatKey])
    @@index([invoiceId])
    @@index([createdAt])
}
