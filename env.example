NODE_ENV='development'

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/invoce-hopko?schema=public"

# NextAuth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Mail
EMAIL_SERVER_USER=username
EMAIL_SERVER_PASSWORD=password
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587

SENTRY_AUTH_TOKEN=''
SENTRY_DSN="your-sentry-dsn-here"
SENTRY_ORG="your_org"
SENTRY_PROJECT="your_prj"

# Public Sentry DSN used by the browser and the tunnel
NEXT_PUBLIC_SENTRY_DSN="your-public-sentry-dsn-here"

# Bearer secret for the purge cron
CRON_SECRET="generate-with-openssl-rand-base64-32"

# HMAC key for sign-in limit address and source keys
LIMIT_KEY_SECRET="generate-with-openssl-rand-base64-32"

# Optional: sign-in response floor in ms (p90 send time measured on preview; default 1000, clamped to 300-1200)
# SIGNIN_RESPONSE_FLOOR_MS=1000

# Vercel AI Gateway key (the model is billed through the gateway)
AI_GATEWAY_API_KEY="your-ai-gateway-key-here"

# Optional: chat model id through the gateway (default anthropic/claude-haiku-5.5); only another anthropic/* id works, another vendor needs GATEWAY_PROVIDER_OPTIONS and the privacy/terms pages changed
# AI_CHAT_MODEL=anthropic/claude-haiku-5.5

# Set only by the e2e harness (tests/e2e/support/start-app-server.mjs), together with AI_CHAT_MODEL=stub:e2e,
# to answer the chat from a scripted stub model. Never set in a real deployment.
# E2E=1
